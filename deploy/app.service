[Unit]
Description=Anomaly Prediction Streamlit App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/anomaly-web
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/anomaly-web/.venv/bin/streamlit run /opt/anomaly-web/streamlit_app.py --server.address 127.0.0.1 --server.port 8501
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
